# =========================================================================
# Configurações de Ambiente para Produção - Portal Falcon
# Copie este arquivo para '.env' no seu servidor de produção e ajuste os valores.
# =========================================================================

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=substitua_por_uma_senha_forte_e_segura
POSTGRES_DB=falcon_db
POSTGRES_PORT=5433

# --- Configurações do NextAuth ---
# Substitua o IP abaixo pelo IP do seu servidor na VPN Tailscale (ex: 100.xx.xx.xx)
NEXTAUTH_URL=http://100.123.45.67:3000
NEXTAUTH_SECRET=substitua_por_um_hash_aleatorio_longo
